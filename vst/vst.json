{
  "name": "Nova Editor",
  "vendor": "3dthc",
  "uid": "NvEd",
  "version": 1070,
  "so": "nova_editor.so",
  "params": "params.json",
  "layout": "layout.conf",
  "art": "html",
  "defines": {
    "HAS_DISPLAY_REV": 1,
    "PARAM_TEXT_MAX": 96
  },
  "build": {
    "root": "..",
    "sources": [
      "src/engine.c"
    ],
    "cflags": [
      "-Ithird_party",
      "-Isrc"
    ],
    "libs": [
      "-ldl",
      "-lm"
    ]
  },
  "skin_os": 2,
  "targets": [
    "armv7",
    "aarch64"
  ]
}
